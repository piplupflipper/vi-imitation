{
  "id": "lsp",
  "command": "./vi-imitation-ext-lsp",
  "saveHook": true,
  "activation": [
    { "on": "filetype", "pattern": "go" }
  ],
  "provides": [
    "definition", "implementation", "typeDefinition", "hover",
    "references", "documentSymbols", "workspaceSymbols",
    "format", "rename"
  ],
  "contributes": {
    "commands": [
      { "id": "lsp.inlayHints.toggle", "description": "LSP のインレイヒント（型や引数の名前）を出すかどうかを切り替える" }
    ]
  }
}
