{
  "id": "treesitter",
  "command": "./vi-imitation-ext-treesitter",
  "activation": [
    { "on": "filetype", "pattern": "go" },
    { "on": "filetype", "pattern": "json" },
    { "on": "filetype", "pattern": "jsonc" },
    { "on": "settingsFileType", "pattern": "/parsers/*/fileTypes" }
  ],
  "contributes": {
    "textObjects": [
      { "id": "treesitter.block.around", "keys": "an", "description": "構文のまとまり（関数、if、for、オブジェクトなど）の全体。ビジュアルモードで繰り返すと外へ広げる（tree-sitter）" },
      { "id": "treesitter.block.inner", "keys": "in", "description": "構文のまとまりの中身（括弧の内側、本体）。ビジュアルモードで繰り返すと外へ広げる（tree-sitter）" },
      { "id": "treesitter.parameter.around", "keys": "aa", "description": "引数と区切りの ,（tree-sitter）" },
      { "id": "treesitter.parameter.inner", "keys": "ia", "description": "引数 1 つ（tree-sitter）" }
    ]
  }
}
