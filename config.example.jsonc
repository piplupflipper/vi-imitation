// vi-imitation の設定の例（キーの割り当てと見た目）。
// $XDG_CONFIG_HOME/vi-imitation/config.jsonc（未設定なら ~/.config/vi-imitation/config.jsonc）に写して使う。
// 項目の説明は docs/usage.md の「設定ファイル」と「見た目の設定」にある。
//
// 配色は、本体に同梱した iceberg（https://github.com/cocopon/iceberg.vim の暗い背景の色）を選び、その上に colors を重ねる。
// colors に書いたのは、端末の背景を見せる（背景を透過させる）前提の調整、lightline の iceberg に近いステータス行の色、
// iceberg.vim に元の色が無い名前である。
// iceberg.vim から写した値と写した元は、internal/config/colors/iceberg.jsonc にある。
// 24 ビットの色を出せる端末で使う。
{
  // インサートモードの Emacs 風のキー。右辺の { "action": "<ID>" } は本体の操作で、ID の一覧は docs/usage.md の「操作の ID の一覧」にある。
  // 本体の既定のキー（<Left>、<BS>、<Del> など）はそのまま使える
  // Ctrl-H（前の文字を消す）は書かない。端末も tmux も Ctrl-H を ^H（0x08）で送り、本体は <BS> と読むので、
  // <C-h> の割り当ては効かない。Ctrl-H は <BS> の既定（insert.delete-prev-char）で前の文字を消す
  "keymap": {
    "insert": {
      "<C-a>": { "action": "insert.line-start" }, // 行の先頭へ
      "<C-e>": { "action": "insert.line-end" }, // 行末の位置へ
      "<C-f>": { "action": "insert.right" }, // 右へ
      // 左へ。tmux の prefix が既定の C-b のままなら、Ctrl-B は tmux が受け取り、本体に届かない
      "<C-b>": { "action": "insert.left" },
      "<C-n>": { "action": "insert.down" }, // 下の行へ
      "<C-p>": { "action": "insert.up" }, // 上の行へ
      "<C-d>": { "action": "insert.delete-char" }, // カーソルの文字を消す
      "<C-k>": { "action": "insert.delete-to-line-end" }, // カーソルから行末まで消す（行末では次の行をつなげる）
      "<C-w>": { "action": "insert.delete-prev-word" }, // 前の単語を消す（行の先頭では前の行とつなげる）
      "<C-u>": { "action": "insert.delete-to-line-start" }, // カーソルから行の先頭まで消す
    },
    // 外部の TUI を、端末多重化ソフト（tmux、herdr）の画面の中央のポップアップで開く（:terminal.popup keifu-wt に当たる）。
    // 端末多重化ソフトの外では :! と同じく端末を渡して動かす。使うときはコメントを外し、keifu-wt を手元にあるコマンドに替える。
    // 説明は docs/usage.md の「コマンドをポップアップで動かす」にある
    // 下の <Leader>gm は、origin/develop と HEAD の merge-base との差分があるファイルの一覧を開く（:git.changes origin/develop... に当たる）。
    // 既定の <Leader>gV は既定のブランチ（origin/HEAD、origin/main など）との merge-base と比べるので、別のブランチへ MR を出すときに使う。
    // 説明は docs/usage.md の「ブランチとの差分があるファイルを見比べる」にある
    // "normal": {
    //   "<Leader>gk": { "command": "terminal.popup", "args": "keifu-wt" },
    //   "<Leader>gm": { "command": "git.changes", "args": "origin/develop..." },
    // },
  },

  "colorscheme": "iceberg",

  "colors": {
    // 端末の背景を透過させる前提の調整
    // iceberg の NonText（#242940）は透過した背景では見えないので、LineNr の文字の色（#444b71）を使う
    "nontext": { "fg": "#444b71" },
    // 空白の記号（whitespace.show）も、iceberg の Whitespace（#242940）では見えないので、行末の記号（nontext）と同じ色にする
    "whitespace": { "fg": "#444b71" },
    // 浮かべる窓、メッセージ、印の列、行番号の列、タブの行のいまのタブには背景の色を付けない
    // （iceberg の背景の色が、透過した背景の上で帯に見えるため）。文字の色は iceberg と同じにする
    "popup": { "fg": "#c6c8d1" },
    "message.warning": { "fg": "#e27878" },
    "message.error": { "fg": "#e27878" },
    "tabline.selected": { "fg": "#9a9ca5" },
    "sign.diagnostic.error": { "fg": "#e27878" },
    "sign.diagnostic.warning": { "fg": "#e2a478" },
    "sign.diagnostic.info": { "fg": "#89b8c2" },
    "sign.diagnostic.hint": { "fg": "#6b7089" },
    "linenr": { "fg": "#444b71" },

    // ステータス行を lightline の iceberg に近づける。値は iceberg.vim（コミット 23835d5ed696436f716cbfdb56a93a7850fe3b18）の
    // autoload/lightline/colorscheme/iceberg.vim の dark の側のパレットから写した。
    // 真ん中の区画は、同梱の iceberg の statusline（StatusLine の反転。明るい帯）を置き換える
    "statusline": { "fg": "#3e445e", "bg": "#0f1117" }, // p.normal.middle（col_base）
    "statuslinenc": { "fg": "#3e445e", "bg": "#0f1117" }, // p.inactive.middle（col_nc）
    // 部品は、下の statusline の並び（左は mode、name、modified、readonly、右は recording、filetype、memusage.rss、ruler、position）を
    // lightline の区画に当てた。左の 1 つ目と右の端は col_normal と col_edge、その内側は col_gradient で、
    // それより内側の部品（recording、filetype、memusage.rss）は真ん中の区画の色のままにする
    "statusline.mode": { "bold": true }, // lightline に元の色は無い
    "statusline.mode.normal": { "fg": "#17171b", "bg": "#818596" }, // p.normal.left[0]（col_normal）
    "statusline.mode.insert": { "fg": "#161821", "bg": "#84a0c6" }, // p.insert.left[0]（col_insert）
    "statusline.mode.visual": { "fg": "#161821", "bg": "#b4be82" }, // p.visual.left[0]（col_visual）
    // lightline の iceberg にコマンドラインのモードの色は無いので、ノーマルモードと同じ色にする
    "statusline.mode.commandline": { "fg": "#17171b", "bg": "#818596" },
    "statusline.name": { "fg": "#6b7089", "bg": "#2e313f" }, // p.normal.left[1]（col_gradient）
    "statusline.modified": { "fg": "#6b7089", "bg": "#2e313f" }, // p.normal.left[1]（col_gradient）
    "statusline.readonly": { "fg": "#6b7089", "bg": "#2e313f" }, // p.normal.left[1]（col_gradient）
    "statusline.ruler": { "fg": "#6b7089", "bg": "#2e313f" }, // p.normal.right[1]（col_gradient）
    "statusline.position": { "fg": "#17171b", "bg": "#818596" }, // p.normal.right[0]（col_edge）

    // iceberg.vim に元の色が無い名前
    "popup.border": { "fg": "#6b7089" },
    "sign.executionPoint": { "fg": "#e2a478", "bold": true },
    "sign.breakpoint": { "fg": "#e27878" },
    "sign.breakpointUnverified": { "fg": "#6b7089" },
  },

  // 記号。端末の文字幅の設定（曖昧な幅の文字を 2 列にする設定）によっては、罫線と ● の列がずれる
  "symbols": {
    "popup.border": "╭─╮│╯─╰│",
    "sign.breakpoint": "●",
    "sign.breakpointUnverified": "○",
    // 印の列の診断の印（nvim の vim.diagnostic.config の signs.text と同じ記号。本体の既定は E、W、I、H）
    "sign.diagnostic.error": "✘",
    "sign.diagnostic.warning": "▲",
    "sign.diagnostic.info": "ⓘ",
    "sign.diagnostic.hint": "⚑",
    // 空白の記号（whitespace.show が true のときに描く）。オーナーの nvim の listchars = { tab = "→ ", lead = "·", trail = "·", eol = "↲" } と同じ。
    // 書かない記号は本体の既定（nbsp は "+"）のままなので、nvim の listchars に無い nbsp は空にして描かない
    "whitespace.tab": "→ ",
    "whitespace.lead": "·",
    "whitespace.trail": "·",
    "whitespace.eol": "↲",
    "whitespace.nbsp": "",
    // 画面の右下の進み具合の、終わった印（fidget.nvim の done_icon の既定と同じ記号。本体の既定は done）。
    // 続いている印は本体の既定（...）のまま。fidget.nvim の回る印は、本体が時間ごとに描き直さないので使えない
    "progress.done": "✔",
    // 失敗して終わった進み具合の印（本体の既定は failed。印の列の誤りの診断の印と同じ記号にした）
    "progress.failed": "✘",
    // 右端のスクロールバーの診断の印（本体の既定は E、W、I、H）。nvim-scrollview の既定と同じく、印の列の診断の印と同じ記号にした。
    // 検索の一致の印は本体の既定（=）のまま
    "scrollbar.diagnostic.error": "✘",
    "scrollbar.diagnostic.warning": "▲",
    "scrollbar.diagnostic.info": "ⓘ",
    "scrollbar.diagnostic.hint": "⚑",
    // 画面の上のポップアップのコマンドライン（下の commandLine の popup）の枠の題。本体の既定は Cmdline、Search forward、Search backward。
    // noice.nvim が入力の行の頭に出す Nerd Font の印（: は U+F054、/ は U+F002 と U+F103、? は U+F002 と U+F102）を、
    // noice.nvim の題（Cmdline と Search）の前に付けた。Nerd Font が入っていない環境では、この 3 行を消す
    "commandLine.title.command": " Cmdline",
    "commandLine.title.searchForward": "  Search",
    "commandLine.title.searchBackward": "  Search",
  },

  // ファジーファインダーとファイラの項目の前に、ファイルの種類のアイコンを付ける（本体の既定も付ける）。
  // アイコンは Nerd Font のグリフなので、Nerd Font が入っていない環境（端末のフォントに Nerd Font を使っていない環境）なら
  // show を false にする。付けたままだと、アイコンの位置に四角や ? が出る。
  // アイコンの文字と色は、ファイルの種類ごとに "fileTypes": { "go": { "text": "…", "fg": "#00add8" } } のように書き換えられる
  "icons": { "show": true },

  // ステータス行の並び。
  // memusage.rss は標準の拡張機能 memusage の部品で、本体と、拡張機能と言語サーバーなどの RSS を "vi 18M · ext 410M" の形で
  // 5 秒ごとに出す（nvim の lualine の lualine_y に置いた memusage.lua の部品に当たる）。内訳は :memusage.show で出す。
  // 並べると本体の起動時に拡張機能を起動するので、要らなければ並びから外す（本体の既定の並びには無い）
  "statusline": {
    "left": ["mode", "name", "modified", "readonly"],
    "right": ["recording", "filetype", "memusage.rss", "ruler", "position"],
  },

  // 行番号の列を出す（:set number に当たる。本体の既定は Vim と同じく出さない）。
  // 列の幅は minWidth と、最後の行の番号の桁数に 1 を足した数の大きい方なので、5 にすると 9999 行までは幅が変わらず本文の位置がずれない
  "lineNumber": { "show": true, "minWidth": 5 },

  // 長い行を本文の幅で折り返す（:set wrap に当たる。本体の既定は折り返さずに横にスクロールする。Vim と Neovim の既定は折り返す）。
  // 見た目の行で上下に動くのは gj と gk（操作の ID は display-down と display-up）。j と k を見た目の行で動かすには、
  // keymap の normal に "j": { "action": "display-down" }, "k": { "action": "display-up" } と書く
  "lineWrap": { "enabled": true },

  // タブ文字、空白、行末を記号で描く（:set list に当たる。本体の既定は Vim と同じく描かない）。記号は上の symbols の whitespace.* にある
  "whitespace": { "show": true },

  // カーソルの上下に 5 行、行を折り返さないときの左右に 8 列の余白を残してスクロールする（:set scrolloff=5 sidescrolloff=8 に当たる。
  // オーナーの nvim と同じ値。本体の既定は Vim と Neovim と同じく 0 で、余白を残さない）
  "scroll": { "margin": 5, "sideMargin": 8 },

  // マウスを使う（nvim の mouse=a に当たる。本体の既定は Vim と同じく使わない）。左のクリックで移り、ドラッグで選び、
  // ホイールで 3 行（横は 6 列）ずつ送る（nvim の既定の mousescroll=ver:3,hor:6 と同じ。量は scrollLines と scrollColumns で変える）。
  // 使っている間に端末の側でテキストを選ぶ操作は、端末ごとに決まっている。説明は docs/usage.md の「マウス」にある
  "mouse": { "enabled": true },

  // コマンドラインの <Tab> で、1 回目は候補の共通の先頭まで補って候補の一覧を出し、2 回目から候補を順に入れる
  // （nvim の wildmode=longest:full,full に当たる。本体の既定は Vim と同じく full で、1 回目から最初の候補を入れる）。
  // ファイルの名前は大文字と小文字を区別せずに補い（nvim の wildignorecase）、一覧は 12 行まで出す（nvim の pumheight=12。本体の既定は 0 で、
  // 画面に収まるだけ出す）。一覧の間は <C-n>、<C-p>、<Up>、<Down> で選び、<C-e> で取り消し、<C-y> で決める。
  // 説明は docs/usage.md の「コマンドラインの補完」にある
  // popup で、: と / と ? の入力を、画面の最後の行の代わりに、画面の上の中央の枠に出し、候補の一覧をその枠のすぐ下に同じ幅で出す
  // （nvim の noice.nvim の cmdline = { view = "cmdline_popup" } と presets.command_palette = true に当たる。本体の既定は Vim と同じく最後の行）。
  // 枠線は上の symbols の popup.border、題は symbols の commandLine.title.*、色は colors の commandLine.popup.border などである。
  // 説明は docs/usage.md の「コマンドラインを画面の上に出す」にある
  "commandLine": { "completeMode": "longest:full,full", "completeIgnoreCase": true, "popup": true },
  "completionMenu": { "height": 12 },

  // 直前の検索のパターンに一致する範囲に色を付ける（:set hlsearch に当たる。本体の既定は Vim と同じく付けない）。
  // 色は :nohlsearch で次の検索まで消せる。<C-l> で消すには、keymap の normal に "<C-l>": { "command": "search.clearHighlight" } と書く
  // / と ? は、打つたびに次の一致へ画面を動かして色を付ける（:set incsearch に当たり、常に行う）。
  // 1 回の検索の時間の上限は incrementalTimeoutMs（既定は 500）で、超えたらその回は一致を出さない。
  // showCount は、検索で動いたときにメッセージの行の右に一致の件数（[2/5]）を出す（Neovim の既定の表示。本体の既定は Vim と同じく出さない）
  "search": { "highlight": true, "showCount": true },

  // y でヤンクした範囲に、300 ミリ秒だけ色を付ける（nvim の vim.hl.on_yank({ timeout = 300 }) に当たる。本体の既定は 0 で付けない）。
  // マクロの再生と . の繰り返しの中のヤンクには付けない。色の名前は yank
  "yank": { "highlightMs": 300 },

  // カーソルを 100 ミリ秒止めると、カーソルの行の診断をカーソルの近くのポップアップに出す
  // （nvim の updatetime=100 と、CursorHold の自動コマンドの vim.diagnostic.open_float に当たる。本体の既定は出さず、時間は 4000）。
  // 出すときは、最下行には診断の本文を出さない。説明は docs/usage.md の「診断のポップアップ」にある
  "diagnostic": { "popup": true },
  "cursorHold": { "delayMs": 100 },

  // 言語サーバーの読み込み、tree-sitter のパーサの用意などの進み具合を、画面の右下に重ねて出す（nvim の fidget.nvim に当たる）。
  // 本体の既定も出す。終わったものは doneMs（既定は 3000）ミリ秒の後に消える。印は上の symbols の progress.* にある。
  // 説明は docs/usage.md の「拡張機能の進み具合」にある
  "progress": { "show": true },

  // ファイルが画面に収まらないとき、画面の右端の列に、今見ている範囲のつまみと、診断と検索の一致の位置の印を出す
  // （nvim の nvim-scrollview に当たる。本体の既定は出さない）。currentOnly で、最後にキーを打った client の画面にだけ出す
  // （見比べで分割したときにバーが 2 本出ないように。nvim-scrollview の current_only = true と同じ）。
  // 出す印は marks（既定は "diagnostic,search"）で選ぶ。検索の一致の印は、search.highlight で一致に色を付けている間だけ出る。
  // nvim-scrollview の excluded_filetypes に書くファイラとヘルプは、本体ではポップアップかペインで開くので、もともとバーを出さない。
  // ほかに出さないファイルの種類があれば、excludedFileTypes に "markdown,gitcommit" のようにコンマで区切って書く。
  // 説明は docs/usage.md の「スクロールバー」にある
  "scrollbar": { "show": true, "currentOnly": true },

  // 引数なしで起動したときに画面の中央に出す案内（名前と版、:q と :help、設定ファイルの場所）。本体の既定は Vim と Neovim と同じく出す。
  // 出さないときは次の行のコメントを外す（nvim の set shortmess+=I に当たる）。:intro は、この設定によらず案内を出す。
  // 説明は docs/usage.md の「起動の案内」にある
  // "intro": { "show": false },

  // 字下げを 4 列のスペースで作り、タブ文字を 4 列で描き、自動インデントを行う
  // （nvim の expandtab、shiftwidth=4、softtabstop=4、tabstop=4、autoindent に当たる。本体の既定は Vim と同じくタブ文字、8 列、自動インデントなし）。
  // ここに書いた値は、どのバッファにも開いたときに当てる。Go と Makefile は、本体のファイルの種類ごとの既定でタブ文字で字下げする
  // （ここの useSpaces より後に当てる。nvim の ftplugin と同じ）。開いたファイルに当たる .editorconfig があれば、その値が勝つ。
  // 説明は docs/usage.md の「字下げとタブの幅」にある
  "indent": { "useSpaces": true, "width": 4, "auto": true },
  "tab": { "width": 4 },

  // ファイルのアンドゥの履歴を、保存するときに $XDG_STATE_HOME/vi-imitation/undo/ に残し、次に開いたときに読み戻す
  // （nvim の undofile=true に当たる。:set undofile でも切り替えられる。本体の既定は Vim と同じく残さない）。
  // 保存した後にファイルが外で変わっていたら、履歴は読まずに捨てる
  "undo": { "persist": true },

  // ファイルを閉じたときのカーソルの位置を $XDG_STATE_HOME/vi-imitation/state.json に残し、次に開いたときにその位置へ戻す
  // （Vim の defaults.vim の BufReadPost の自動コマンドに当たる。本体の既定は戻さない）。git のコミットのメッセージでは戻さない。
  // 説明は docs/usage.md の「アンドゥの履歴とカーソルの位置を残す」にある
  "cursor": { "restore": true },

  // ファイルの種類ごとの値。キーは filetype の値で、中は最上位と同じ形で書く（範囲がバッファごとの項目だけを書ける）。
  // 例えば YAML を 2 列で字下げするなら、次の行のコメントを外す
  // gc と gcc（ノーマルモードとビジュアルモードの <C-/> も）で切り替えるコメントの形（comment.string。nvim の commentstring）も、
  // ここで変えられる。Go、Python などの既定は本体が持つ（nvim の ftplugin と同じ値。docs/usage.md の「コメントの切り替え」）
  "fileTypeOptions": {
    // "yaml": { "indent": { "width": 2 } },
    // "c": { "comment": { "string": "/* %s */" } },
  },

  // Ex コマンドの別名。名前から、付け替える先のコマンド（command）と、省略できる最短の長さ（min。省くと省略できない）への対応である。
  // 説明は docs/usage.md の「Ex コマンドの別名を足す」にある。省略の長さは Vim 9.1 と同じにした（:tab は Vim の修飾子、:tabn は :tabnext）
  "commandAliases": {
    // :tabe[dit] ファイル は :e ファイル と同じく、ファイルを新しいタブで開く。引数なしの :tabe は Vim と同じく空のタブを開く
    "tabedit": { "command": "tab.new", "min": 4 },
    // :tabnew は名前の無い空のタブを開く。:tabnew ファイル は :e ファイル と同じ
    "tabnew": { "command": "tab.new" },
  },

  // 本体の既定の表に無い拡張子のファイルの種類（下の整形ツールの fileTypes に使う）。名前は nvim の filetype にそろえた
  "fileTypes": {
    ".tsx": "typescriptreact",
    ".jsx": "javascriptreact",
    ".mjs": "javascript",
    ".cjs": "javascript",
    ".css": "css",
    ".graphql": "graphql",
    ".gql": "graphql",
    ".lua": "lua",
    ".bash": "bash",
    ".fish": "fish",
    ".cpp": "cpp",
    ".cc": "cpp",
    ".hpp": "cpp",
  },

  "extensions": {
    // 保存の前の整形（下の formatter）の期限。整形ツールの応答をこの時間まで待ち、超えたら整形せずに書き出す（本体の既定は 1000）
    "willSaveTimeoutMs": 2000,
    "settings": {
      // tree-sitter の拡張機能。説明は docs/usage.md の「関数とクラスの見出しを窓の上端に出す」にある
      "treesitter": {
        // 関数とクラスの見出しを窓の上端に出す帯（nvim-treesitter-context の max_lines = 4、multiline_threshold = 1 と同じ）。
        // 一時的に消すときは :treesitter.context.toggle
        "context": {
          // 深い入れ子で画面を占領しないよう、帯は 4 行まで（拡張機能の既定は 0 で上限なし）
          "maxLines": 4,
          // 複数の行にまたがる見出しも 1 行に切り詰める（拡張機能の既定は 20）
          "multilineThreshold": 1,
        },
        // カーソルを含むブロックの範囲を、字下げに重ねる罫線で示す（オーナーの nvim の hlchunk.nvim の chunk と同じ記号と時間）。
        // 説明は docs/usage.md の「ブロックの範囲を罫線で示す」にある
        "chunk": {
          // 拡張機能の既定は出さない
          "enable": true,
          // カーソルが止まってから 100 ミリ秒で描き直し、100 ミリ秒で描く（拡張機能の既定は hlchunk.nvim と同じ 300 と 200）
          "delay": 100,
          "duration": 100,
          // 始まりの行の本文の側の端（leftArrow）は、hlchunk.nvim の既定と同じ ─ のまま
          "symbols": { "horizontalLine": "═", "verticalLine": "║", "leftTop": "╔", "leftBottom": "╚", "rightArrow": "▶" },
        },
      },
      // LSP の言語サーバーを足す例（Python の pyright）。説明は docs/usage.md の「LSP」にある。
      // 既定の言語サーバーは Go の gopls だけで、ほかの言語は servers と activation の両方に書く
      "lsp": {
        // 言語サーバーが対応していれば、インレイヒント（型や引数の名前）を本文の間に出す（本体の既定は出さない。nvim の
        // vim.lsp.inlay_hint.enable に当たる）。実行中は :lsp.inlayHints.toggle で切り替える。色は colors の inlayHint
        "inlayHints": true,
        "servers": {
          // gopls はヒントの種類ごとに有効にする設定が要る（既定はどれも出さない）。servers.go を書くと既定の go の設定を置き換えるので、
          // command と rootMarkers も書く
          "go": {
            "command": "gopls",
            "rootMarkers": ["go.work", "go.mod", ".git"],
            "settings": {
              "gopls": {
                "hints": {
                  "assignVariableTypes": true,
                  "compositeLiteralFields": true,
                  "constantValues": true,
                  "functionTypeParameters": true,
                  "parameterNames": true,
                  "rangeVariableTypes": true,
                },
              },
            },
          },
          "python": {
            "command": "pyright-langserver",
            "args": ["--stdio"],
            "rootMarkers": ["pyproject.toml", "setup.py", ".git"],
            // pyright-langserver が PATH に無いときに案内する mise の道具の ID。
            // 版は、自分の mise の設定（~/.config/mise/config.toml）に書いた版に合わせる
            "mise": "npm:pyright@1.1.410",
            // Python は下の ruff で整形するので、言語サーバーには保存の前の整形をさせない（nvim の conform.nvim の lsp_format = "never"）
            "formatOnSave": false,
          },
        },
        // true にすると、PATH に無い言語サーバーを、案内する代わりに mise に入れさせてから起動する
        "autoInstall": false,
      },
      // 外部の整形ツールで、保存の前（:w）と gq、:format で整形する。説明は docs/usage.md の「整形ツール」にある。
      // 引数の {path} はファイルの絶対パスになる。実行ファイルは、ファイルのディレクトリから上へ node_modules/.bin と .venv/bin を探し、
      // 無ければ PATH から探す。見つからない整形ツールは、そのファイルの種類で保存するたびに知らせ、整形せずに書き出す。
      // 引数は conform.nvim（016802d）の定義に合わせた。
      // biome、prettier、ruff を書いたファイルの種類では、その整形ツールの設定ファイル（biome.json、.prettierrc、pyproject.toml など）から
      // インデントの文字と幅を読み、.editorconfig より優先する（:set で変えた値には勝たない）
      "formatter": {
        "formatters": [
          {
            // 整形に加えて、lint の修正と import の並べ替えもする
            "command": "biome",
            "args": ["check", "--write", "--stdin-file-path={path}"],
            "fileTypes": ["json", "jsonc", "typescript", "typescriptreact", "javascript", "javascriptreact", "css", "graphql"],
          },
          { "command": "taplo", "args": ["format", "--stdin-filepath", "{path}", "-"], "fileTypes": ["toml"] },
          { "command": "ruff", "args": ["format", "--force-exclude", "--stdin-filename", "{path}", "-"], "fileTypes": ["python"] },
          {
            "command": "stylua",
            "args": ["--search-parent-directories", "--respect-ignores", "--stdin-filepath", "{path}", "-"],
            "fileTypes": ["lua"],
          },
          { "command": "shfmt", "args": ["-filename", "{path}"], "fileTypes": ["sh", "bash"] },
          { "command": "fish_indent", "fileTypes": ["fish"] },
          { "command": "clang-format", "args": ["-assume-filename", "{path}"], "fileTypes": ["c", "cpp"] },
          // conform.nvim は Cargo.toml の edition を読むが、ここでは 2021 に決めて渡す
          { "command": "rustfmt", "args": ["--emit=stdout", "--edition=2021"], "fileTypes": ["rust"] },
        ],
      },
    },
    "activation": { "lsp": [{ "on": "filetype", "pattern": "python" }] },
  },
}
