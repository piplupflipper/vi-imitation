// 同梱の配色 iceberg（https://github.com/cocopon/iceberg.vim。MIT License、Copyright (c) 2014 cocopon）。
// 設定ファイルに "colorscheme": "iceberg" と書くと使う（FR-125）。書式は設定の colors の値と同じである。
//
// 値は iceberg.vim のコミット 23835d5ed696436f716cbfdb56a93a7850fe3b18 の colors/iceberg.vim だけから写した。
// 写したのは dark の側（&background が light でない側）のハイライトグループの guifg、guibg、guisp と gui の飾りである。
// 同じリポジトリの lightline と airline のテーマの色は、配色そのものの色ではないので入れていない
// （lightline に近いステータス行の色は、config.example.jsonc の colors にある）。
// 端末の背景を透過させる前提の調整は入れていない。本体には本文の文字と背景の色を指す名前が無いので、Normal の色は写していない。
// colors/iceberg.vim に対応するハイライトグループが無い名前（message.info、popup.border、popup.match、statusline. で始まる部品の色、
// sign.executionPoint、sign.breakpoint、sign.breakpointUnverified、progress、commandLine.popup、
// band.bottom（nvim-treesitter-context の TreesitterContextBottom の既定のリンク先は NONE）は書いていない。書いていない名前は本体の既定の色になる。
// 窓の上端の帯の band と band.linenr も書いていない。本体は、書いていなければ popup と linenr の今の色を引き継ぐ
// （nvim-treesitter-context の TreesitterContext と TreesitterContextLineNumber は NormalFloat と LineNr へのリンク）ので、
// 配色に値を書くと、設定の colors で popup や linenr を変えても帯が付いてこなくなる（PR #376 の再レビューの推奨）。
{
  // 構文の色。本体の名前は tree-sitter の捕捉の名前に当たるので、Neovim の tree-sitter のグループ（TS...）から写した
  "comment": { "fg": "#6b7089" }, // TSComment → Comment
  "keyword": { "fg": "#84a0c6" }, // TSKeyword → Statement
  "string": { "fg": "#89b8c2" }, // TSString → String
  "number": { "fg": "#a093c7" }, // TSNumber → Constant
  "constant": { "fg": "#a093c7" }, // TSConstant → Constant
  "function": { "fg": "#a3adcb" }, // TSFunction
  "type": { "fg": "#84a0c6" }, // TSType → Type
  "variable": { "fg": "#c6c8d1" }, // TSVariable → icebergNormalFg
  "operator": { "fg": "#c6c8d1" }, // TSOperator → icebergNormalFg
  "punctuation": { "fg": "#c6c8d1" }, // TSPunctDelimiter、TSPunctBracket → icebergNormalFg

  // 画面の部品
  "visual": { "bg": "#272c42" }, // Visual
  "nontext": { "fg": "#242940" }, // NonText
  "specialkey": { "fg": "#515e97" }, // SpecialKey（Neovim の側。Vim では Whitespace へのリンク）
  "whitespace": { "fg": "#242940" }, // Whitespace（空白の記号。NonText と同じ色）
  "linenr": { "fg": "#444b71", "bg": "#1e2132" }, // LineNr
  "search": { "fg": "#392313", "bg": "#e4aa80" }, // Search
  // 打つたびの検索の今の一致。IncSearch は gui=reverse だけで、nvim は Search の色を重ねずに Normal の文字と背景の色を入れ替えて出す。
  // 本体の reverse は下の search の色を入れ替えるので、Normal（guifg=#c6c8d1 guibg=#161821）を入れ替えた色を書いた
  "incsearch": { "fg": "#161821", "bg": "#c6c8d1" }, // IncSearch
  // ヤンクした範囲。iceberg.vim に対応するグループは無い。nvim の vim.hl.on_yank が既定で使う IncSearch は反転だけで、
  // 選択（visual）と重なると反転が残って選択の色が上に出ないので、文字と背景の色を持ち、visual と search と見分けられる色を選んだ
  "yank": { "fg": "#eff0f4", "bg": "#5b6389" }, // PmenuSel
  "message.warning": { "fg": "#e27878", "bg": "#161821" }, // WarningMsg
  "message.error": { "fg": "#e27878", "bg": "#161821" }, // ErrorMsg
  "popup": { "fg": "#c6c8d1", "bg": "#3d425b" }, // Pmenu
  "popup.selected": { "fg": "#eff0f4", "bg": "#5b6389" }, // PmenuSel
  "popup.scrollbar": { "bg": "#3d425b" }, // PmenuSbar
  "popup.thumb": { "bg": "#c6c8d1" }, // PmenuThumb
  "finder.match": { "fg": "#e2a478" }, // CtrlPMatch、deniteMatchedChar → Title
  // 項目のプレビューの、項目の指す行。iceberg.vim に専用のグループは無く、fzf-lua のプレビューの FzfLuaCursorLine が既定で
  // リンクする CursorLine の背景を写した（文字の色は持たず、構文の色を残す）
  "preview.line": { "bg": "#1e2132" }, // CursorLine
  // 画面の右下の進み具合の表題と印。fidget.nvim の既定（progress_style が WarningMsg、done_style が Constant）のグループの
  // 文字の色を写した。進み具合はバッファの本文の上に重ねるので、WarningMsg の背景の色は写していない
  "progress.title": { "fg": "#e27878" }, // WarningMsg
  "progress.done": { "fg": "#a093c7" }, // Constant
  // 失敗して終わった進み具合。fidget.nvim に対応するものは無いので、ErrorMsg の文字の色を写した（WarningMsg と同じ色で、印で見分ける）
  "progress.failed": { "fg": "#e27878" }, // ErrorMsg
  // 右端のスクロールバー。iceberg.vim に専用のグループは無いので、nvim-scrollview の既定のリンク先（ScrollView は Visual、
  // ScrollViewDiagnostics* は印の列の DiagnosticSign*）の色を写した。つまみの上に重ねるので、印には背景の色を写していない。
  // 検索の一致の印だけは、nvim-scrollview の既定のリンク先の NonText（#242940）では、つまみ（#272c42）とのコントラスト比が 1.04、
  // Normal の背景（#161821）とは 1.24 で見えないので、Normal の文字の色（icebergNormalFg）にした。比は順に 8.25 と 10.60 である
  // （WCAG の相対輝度で計算した。PR #351 のレビューの推奨 5）
  "scrollbar": { "bg": "#272c42" }, // Visual
  "scrollbar.diagnostic.error": { "fg": "#e27878" }, // DiagnosticSignError
  "scrollbar.diagnostic.warning": { "fg": "#e2a478" }, // DiagnosticSignWarn
  "scrollbar.diagnostic.info": { "fg": "#89b8c2" }, // DiagnosticSignInfo
  "scrollbar.diagnostic.hint": { "fg": "#6b7089" }, // DiagnosticSignHint
  "scrollbar.search": { "fg": "#c6c8d1" }, // Normal の文字の色（NonText では見えないため）
  // 画面の上のポップアップのコマンドラインの枠線と題。iceberg.vim に専用のグループは無いので、noice.nvim の既定のリンク先
  // （NoiceCmdlinePopupBorder は DiagnosticSignInfo、NoiceCmdlinePopupBorderSearch は DiagnosticSignWarn）の文字の色を写した。
  // 枠の中（commandLine.popup）は、noice.nvim の既定のリンク先が Normal なので書いていない
  "commandLine.popup.border": { "fg": "#89b8c2" }, // DiagnosticSignInfo
  "commandLine.popup.border.search": { "fg": "#e2a478" }, // DiagnosticSignWarn

  // ステータス行。どちらも反転（gui=reverse）なので、文字は guibg の色、背景は guifg の色で出る
  "statusline": { "fg": "#818596", "bg": "#17171b", "reverse": true }, // StatusLine
  "statuslinenc": { "fg": "#0f1117", "bg": "#3e445e", "reverse": true }, // StatusLineNC

  // タブの行
  "tabline": { "fg": "#3e445e", "bg": "#0f1117" }, // TabLine
  "tabline.selected": { "fg": "#9a9ca5", "bg": "#161821" }, // TabLineSel
  "tabline.fill": { "fg": "#0f1117", "bg": "#3e445e", "reverse": true }, // TabLineFill

  // 診断
  "diagnostic.error": { "sp": "#e27878", "underline": true }, // DiagnosticUnderlineError
  "diagnostic.warning": { "sp": "#e2a478", "underline": true }, // DiagnosticUnderlineWarn
  "diagnostic.info": { "sp": "#89b8c2", "underline": true }, // DiagnosticUnderlineInfo
  "diagnostic.hint": { "sp": "#6b7089", "underline": true }, // DiagnosticUnderlineHint

  // 印の列
  "sign.diagnostic.error": { "fg": "#e27878", "bg": "#1e2132" }, // DiagnosticSignError
  "sign.diagnostic.warning": { "fg": "#e2a478", "bg": "#1e2132" }, // DiagnosticSignWarn
  "sign.diagnostic.info": { "fg": "#89b8c2", "bg": "#1e2132" }, // DiagnosticSignInfo
  "sign.diagnostic.hint": { "fg": "#6b7089", "bg": "#1e2132" }, // DiagnosticSignHint

  // 見比べ
  "diff.add": { "fg": "#c0c5b9", "bg": "#45493e" }, // DiffAdd
  "diff.change": { "fg": "#b3c3cc", "bg": "#384851" }, // DiffChange
  "diff.delete": { "fg": "#ceb0b6", "bg": "#53343b" }, // DiffDelete
  "diff.text": { "fg": "#c6c8d1", "bg": "#5b7881" }, // DiffText
}
